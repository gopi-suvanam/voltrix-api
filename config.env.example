# Voltrix API — configuration template
# Copy this file to config.env and fill in the values.
#
# Generate a token + hash by running:
#   .env/Scripts/python generate_token.py

# SHA-256 hash of the Bearer token.
# Leave empty or omit to disable auth (local development only).
API_TOKEN_HASH=

# API version prefix (e.g. v2 → /v2/options, /v2/bonds, /v2/core)
API_VERSION=v2
