{
  "metadata": {
    "name": "Option Pricing",
    "language_info": {
      "name": "JavaScipt",
      "version": "8.0"
    }
  },
  "jsnbversion": "v0.1",
  "cells": [
    {
      "code": "# QuantForge Tests - `/option-price` \n",
      "status": "",
      "output": "<h1>QuantForge Tests - <code>/option-price</code></h1>\n",
      "type": "html"
    },
    {
      "code": "const BASE = \"http://localhost:8000\";\n\nasync function post(path, body) {\n  const res = await fetch(`${BASE}${path}`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify(body),\n  });\n  return res.json();\n}",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "---\n\n## 1. Black-Scholes — Interactive\n",
      "status": "",
      "output": "<hr>\n<h2>1. Black-Scholes — Interactive</h2>\n",
      "type": "html"
    },
    {
      "code": "//>html\n<div>\n  <label>Model\n    <select id=\"op-model\">\n      <option value=\"black_scholes\">black_scholes</option>\n      <option value=\"bachelier\">bachelier</option>\n      <option value=\"monte_carlo\">monte_carlo</option>\n    </select>\n  </label>\n  <label>Type\n    <select id=\"op-type\">\n      <option value=\"call\">call</option>\n      <option value=\"put\">put</option>\n    </select>\n  </label>\n  <label>Spot <input id=\"op-spot\" type=\"number\" value=\"100\"></label>\n  <label>Strike <input id=\"op-strike\" type=\"number\" value=\"100\"></label>\n  <label>Rate <input id=\"op-rate\" type=\"number\" value=\"0.05\" step=\"0.01\"></label>\n  <label>Maturity (yrs) <input id=\"op-ttm\" type=\"number\" value=\"1.0\" step=\"0.25\"></label>\n  <label>Vol (σ) <input id=\"op-vol\" type=\"number\" value=\"0.2\" step=\"0.01\"></label>\n  <label>Div Yield <input id=\"op-div\" type=\"number\" value=\"0.0\" step=\"0.01\"></label>\n</div>",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "const result = await post(\"/option-price\", {\n  model:            document.getElementById(\"op-model\").value,\n  option_type:      document.getElementById(\"op-type\").value,\n  spot:             parseFloat(document.getElementById(\"op-spot\").value),\n  strike:           parseFloat(document.getElementById(\"op-strike\").value),\n  rate:             parseFloat(document.getElementById(\"op-rate\").value),\n  time_to_maturity: parseFloat(document.getElementById(\"op-ttm\").value),\n  dividend_yield:   parseFloat(document.getElementById(\"op-div\").value),\n  volatility:       parseFloat(document.getElementById(\"op-vol\").value),\n  include_insights: true,\n});\nscrib.show(\"Price: \" + result.price);\nscrib.show(result.volatility_used);\nscrib.show(result.insights);",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "---\n\n## 2. Put-Call Parity Check\n\nFor the same inputs, call − put should equal S·e^(−qT) − K·e^(−rT).\nUses the values entered above.\n",
      "status": "",
      "output": "<hr>\n<h2>2. Put-Call Parity Check</h2>\n<p>For the same inputs, call − put should equal S·e^(−qT) − K·e^(−rT).\nUses the values entered above.</p>\n",
      "type": "html"
    },
    {
      "code": "const S = parseFloat(document.getElementById(\"op-spot\").value);\nconst K = parseFloat(document.getElementById(\"op-strike\").value);\nconst r = parseFloat(document.getElementById(\"op-rate\").value);\nconst q = parseFloat(document.getElementById(\"op-div\").value);\nconst T = parseFloat(document.getElementById(\"op-ttm\").value);\nconst v = parseFloat(document.getElementById(\"op-vol\").value);\n\nconst [call, put] = await Promise.all([\n  post(\"/option-price\", { model:\"black_scholes\", option_type:\"call\", spot:S, strike:K, rate:r, time_to_maturity:T, dividend_yield:q, volatility:v }),\n  post(\"/option-price\", { model:\"black_scholes\", option_type:\"put\",  spot:S, strike:K, rate:r, time_to_maturity:T, dividend_yield:q, volatility:v }),\n]);\nconst parity = S * Math.exp(-q * T) - K * Math.exp(-r * T);\nscrib.show(\"Call: \" + call.price + \" | Put: \" + put.price);\nscrib.show(\"Call − Put: \" + (call.price - put.price).toFixed(6));\nscrib.show(\"S·e⁻ᵠᵀ − K·e⁻ʳᵀ: \" + parity.toFixed(6));\nscrib.show(\"Parity holds: \" + (Math.abs((call.price - put.price) - parity) < 0.001));",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "---\n\n## 3. Vol Surface — Interactive\n\nQuery a 3×2 vol matrix at a chosen strike and maturity.\n",
      "status": "",
      "output": "<hr>\n<h2>3. Vol Surface — Interactive</h2>\n<p>Query a 3×2 vol matrix at a chosen strike and maturity.</p>\n",
      "type": "html"
    },
    {
      "code": "//>html\n<div>\n  <label>Query Strike <input id=\"surf-strike\" type=\"number\" value=\"105\"></label>\n  <label>Query Maturity <input id=\"surf-ttm\" type=\"number\" value=\"0.75\" step=\"0.25\"></label>\n  <label>Spot <input id=\"surf-spot\" type=\"number\" value=\"100\"></label>\n  <label>Rate <input id=\"surf-rate\" type=\"number\" value=\"0.05\" step=\"0.01\"></label>\n</div>",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "const result = await post(\"/option-price\", {\n  model: \"black_scholes\",\n  option_type: \"call\",\n  spot:             parseFloat(document.getElementById(\"surf-spot\").value),\n  strike:           parseFloat(document.getElementById(\"surf-strike\").value),\n  rate:             parseFloat(document.getElementById(\"surf-rate\").value),\n  time_to_maturity: parseFloat(document.getElementById(\"surf-ttm\").value),\n  volatility: {\n    vol_type: \"log_normal\",\n    surface_type: \"matrix\",\n    data: {\n      strikes:    [90, 100, 110],\n      maturities: [0.5, 1.0],\n      vol_matrix: [\n        [0.25, 0.24],\n        [0.20, 0.19],\n        [0.22, 0.21],\n      ],\n    },\n    interpolation: \"bilinear\",\n    extrapolation: \"flat\",\n  },\n  include_insights: true,\n});\nscrib.show(\"Price: \" + result.price);\nscrib.show(\"Interpolated σ: \" + result.volatility_used.value + \" (source: \" + result.volatility_used.source + \")\");\nscrib.show(result.insights);",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "---\n\n## 4. Monte Carlo — Path Count Comparison\n\nCompare MC price accuracy as number of simulations increases.\n",
      "status": "",
      "output": "<hr>\n<h2>4. Monte Carlo — Path Count Comparison</h2>\n<p>Compare MC price accuracy as number of simulations increases.</p>\n",
      "type": "html"
    },
    {
      "code": "//>html\n<div>\n  <label>Spot <input id=\"mc-spot\" type=\"number\" value=\"100\"></label>\n  <label>Strike <input id=\"mc-strike\" type=\"number\" value=\"100\"></label>\n  <label>Vol <input id=\"mc-vol\" type=\"number\" value=\"0.2\" step=\"0.01\"></label>\n  <label>Maturity <input id=\"mc-ttm\" type=\"number\" value=\"1.0\" step=\"0.25\"></label>\n  <label>Seed <input id=\"mc-seed\" type=\"number\" value=\"42\"></label>\n</div>",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "const S    = parseFloat(document.getElementById(\"mc-spot\").value);\nconst K    = parseFloat(document.getElementById(\"mc-strike\").value);\nconst v    = parseFloat(document.getElementById(\"mc-vol\").value);\nconst T    = parseFloat(document.getElementById(\"mc-ttm\").value);\nconst seed = parseInt(document.getElementById(\"mc-seed\").value);\n\nconst [bs, mc1k, mc10k, mc50k] = await Promise.all([\n  post(\"/option-price\", { model:\"black_scholes\", option_type:\"call\", spot:S, strike:K, rate:0.05, time_to_maturity:T, volatility:v }),\n  post(\"/option-price\", { model:\"monte_carlo\",   option_type:\"call\", spot:S, strike:K, rate:0.05, time_to_maturity:T, volatility:v, num_simulations:1000,  seed }),\n  post(\"/option-price\", { model:\"monte_carlo\",   option_type:\"call\", spot:S, strike:K, rate:0.05, time_to_maturity:T, volatility:v, num_simulations:10000, seed }),\n  post(\"/option-price\", { model:\"monte_carlo\",   option_type:\"call\", spot:S, strike:K, rate:0.05, time_to_maturity:T, volatility:v, num_simulations:50000, seed }),\n]);\nscrib.show(\"BS (exact):      \" + bs.price);\nscrib.show(\"MC  1,000 paths: \" + mc1k.price  + \" | error: \" + Math.abs(mc1k.price  - bs.price).toFixed(5));\nscrib.show(\"MC 10,000 paths: \" + mc10k.price + \" | error: \" + Math.abs(mc10k.price - bs.price).toFixed(5));\nscrib.show(\"MC 50,000 paths: \" + mc50k.price + \" | error: \" + Math.abs(mc50k.price - bs.price).toFixed(5));",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "---\n\n## 5. CEV Model — Beta Sweep\n\nSee how option price changes as β moves from 0.1 (near-normal) to 1.0 (log-normal).\n",
      "status": "",
      "output": "<hr>\n<h2>5. CEV Model — Beta Sweep</h2>\n<p>See how option price changes as β moves from 0.1 (near-normal) to 1.0 (log-normal).</p>\n",
      "type": "html"
    },
    {
      "code": "//>html\n<div>\n  <label>Spot <input id=\"cev-spot\" type=\"number\" value=\"100\"></label>\n  <label>Strike <input id=\"cev-strike\" type=\"number\" value=\"100\"></label>\n  <label>σ <input id=\"cev-vol\" type=\"number\" value=\"0.2\" step=\"0.01\"></label>\n  <label>Paths <input id=\"cev-sims\" type=\"number\" value=\"20000\"></label>\n</div>",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "const S    = parseFloat(document.getElementById(\"cev-spot\").value);\nconst K    = parseFloat(document.getElementById(\"cev-strike\").value);\nconst sig  = parseFloat(document.getElementById(\"cev-vol\").value);\nconst sims = parseInt(document.getElementById(\"cev-sims\").value);\n\nconst betas = [0.1, 0.3, 0.5, 0.7, 1.0];\nconst results = await Promise.all(betas.map(b =>\n  post(\"/option-price\", {\n    model: \"cev\", option_type: \"call\",\n    spot: S, strike: K, rate: 0.05, time_to_maturity: 1.0,\n    volatility: { surface_type: \"constant\", data: { vol: sig }, other_params: { cev_beta: b } },\n    num_simulations: sims, seed: 42,\n  })\n));\nscrib.show(\"β     | Price\");\nbetas.forEach((b, i) => scrib.show(\"β=\" + b.toFixed(1) + \"  | \" + results[i].price.toFixed(5)));",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "---\n\n## 6. Error Handling\n",
      "status": "",
      "output": "<hr>\n<h2>6. Error Handling</h2>\n",
      "type": "html"
    },
    {
      "code": "//>html\n<div>\n  <label>Spot (try negative) <input id=\"err-spot\" type=\"number\" value=\"-50\"></label>\n  <label>Strike <input id=\"err-strike\" type=\"number\" value=\"100\"></label>\n</div>",
      "status": "",
      "output": "",
      "type": "code"
    },
    {
      "code": "const result = await post(\"/option-price\", {\n  model: \"black_scholes\",\n  option_type: \"call\",\n  spot:   parseFloat(document.getElementById(\"err-spot\").value),\n  strike: parseFloat(document.getElementById(\"err-strike\").value),\n  rate: 0.05, time_to_maturity: 1.0,\n  volatility: 0.2,\n});\nscrib.show(result);",
      "status": "",
      "output": "",
      "type": "code"
    }
  ],
  "source": "https://github.com/gopi-suvanam/scribbler",
  "run_on_load": false
}